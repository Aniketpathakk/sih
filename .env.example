# APAAR-SHIELD Environment Configuration
PORT=4000
NODE_ENV=development

# Database Configuration (Optional: if not set, in-memory / PGlite local database is used)
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/apaar_shield

# Identity Vault Cryptography Keys (Mock & Development defaults)
# 32-byte hex key for AES-256-GCM encryption
IDENTITY_AES_KEY_V1=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
# Key for HMAC-SHA256 matching token generation
IDENTITY_HMAC_KEY_V1=apaar-shield-secure-hmac-secret-v1

# Provider Mode (MOCK | SANDBOX | PRODUCTION)
PROVIDER_MODE=MOCK
MOCK_PROVIDER_LATENCY_MS=50

# JWT Auth Secret
JWT_SECRET=apaar-shield-demo-jwt-secret-2026

